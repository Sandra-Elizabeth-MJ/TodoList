<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp"
    app:cardUseCompatPadding="true"
    android:backgroundTint="@color/plomoA1"
    android:elevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="3dp">

        <!-- Primer Layout con ConstraintLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp">

            <RadioButton
                android:id="@+id/rbtn_tarea"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvTarea_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/azulA1"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/rbtn_tarea"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_eliminar_tarea" />

            <ImageButton
                android:id="@+id/btn_eliminar_tarea"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/plomoA1"
                android:contentDescription="Eliminar tarea"
                android:padding="5dp"
                android:src="@drawable/ic_delete_tarea"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Segundo Layout Horizontal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="65dp">

            <ImageView
                android:id="@+id/icnotificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_notificacion"
                android:contentDescription="@string/hora_y_recordatorio"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvFecha_rv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/azulA1"
                android:textSize="15sp"
                android:hint="@string/mm_dd_aaaa"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/tvHora_rv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/azulA1"
                android:textSize="15sp"
                android:hint="@string/hh_mm_tt"
                android:layout_marginEnd="8dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
